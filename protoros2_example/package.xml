<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>protoros2_example</name>
  <version>0.0.1</version>
  <description>Protobuf for ROS2 example</description>

  <maintainer email="lzs_1993@qq.com">lizhensheng</maintainer>

  <license>Apache License 2.0</license>

  <author email="lzs_1993@qq.com">lizhensheng</author>
  <author>lizhensheng</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rosidl_typesupport_protobuf_cpp</depend>
  <depend>proto2ros</depend>
  <depend>protoros2</depend>

  <depend>rclpy</depend>
  <depend>rosbag2_py</depend>
  <depend>rosidl_runtime_py</depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <depend>builtin_interfaces</depend>
  <depend>ament_index_cpp</depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rosbag2_cpp_protobuf_converter</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
